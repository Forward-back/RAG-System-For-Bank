  "meta": {
    "title": "全栈项目云部署 — 用户访问全流程",
    "subtitle": "浏览器/移动端 → CDN/负载均衡 → 前端服务 → API网关 → 业务服务 → 缓存/数据库 → 监控，含 CI/CD 持续部署",
    "output": "cloud-deployment-flow.html",
    "viewBox": [1100, 800],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "user-request",
        "label": "用户请求路径",
        "focus": ["browser", "cdn", "frontend", "apigateway", "backend", "redis", "database"],
        "note": "从浏览器发出请求到数据持久化的完整热路径。"
      },
      {
        "id": "cicd-deploy",
        "label": "CI/CD 部署",
        "focus": ["cicd", "frontend", "backend", "monitor"],
        "note": "代码提交后自动构建、测试、部署到云服务器的流程。"
      }
    ]
  },
  "stages": [
    { "label": "用户端" },
    { "label": "接入层" },
    { "label": "应用层" },
    { "label": "数据层" },
    { "label": "运维层" }
  ],
  "nodes": [
    { "id": "browser",  "type": "frontend",  "label": "浏览器",   "sublabel": "SPA / SSR",       "stage": 0, "row": 0, "tag": "用户" },
    { "id": "mobile",   "type": "frontend",  "label": "移动App",  "sublabel": "iOS / Android",   "stage": 0, "row": 4, "tag": "用户" },

    { "id": "cdn",      "type": "cloud",     "label": "CDN 加速", "sublabel": "静态资源边缘缓存", "stage": 1, "row": 0, "tag": "边缘节点" },
    { "id": "lb",       "type": "cloud",     "label": "负载均衡", "sublabel": "Nginx / ALB",      "stage": 1, "row": 4, "tag": "流量入口" },

    { "id": "frontend", "type": "frontend",  "label": "前端服务", "sublabel": "Nginx 静态托管",    "stage": 2, "row": 0, "tag": "端口 443" },
    { "id": "apigateway","type": "backend",  "label": "API 网关", "sublabel": "鉴权 / 限流 / 路由", "stage": 2, "row": 2, "tag": "入口" },
