  "cards": [
    {
      "dot": "cyan",
      "title": "用户请求主链路（实线）",
      "items": [
        "浏览器 → CDN → 前端服务：静态资源加速分发，未命中时回源到 Nginx",
        "移动App → 负载均衡 → API 网关 → 业务服务：动态请求经反向代理路由到微服务集群",
        "前端 SPA 通过 Ajax 调用 API 网关，实现前后端分离"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据处理层",
      "items": [
        "业务服务优先查询 Redis 缓存，命中即返回，大幅降低数据库负载",
        "写操作与缓存未命中时，走主数据库 (RDS) 持久化存储",
        "Session / Token 等热数据存放于 Redis，支持集群横向扩展"
      ]
    },
    {
      "dot": "amber",
      "title": "CI/CD 与可观测性（虚线）",
      "items": [
        "代码 Push 到 Git 仓库后，CI/CD 流水线自动构建 Docker 镜像并部署到云服务器",
        "前端静态资源构建后推送至 Nginx 目录或对象存储",
        "业务服务实时上报指标与日志到 Prometheus + Grafana 监控平台"
      ]
    }
  ]
