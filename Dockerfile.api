FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

# Use Aliyun Debian mirror
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources

RUN apt-get update && apt-get install -y \
    build-essential \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-chi-sim \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip -i https://mirrors.aliyun.com/pypi/simple/

COPY requirements.txt .

RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    -r requirements.txt

# torchvision for detectron2 layout detection
RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torchvision

# detectron2 for PDF layout detection (hi_res strategy)
# Falls back gracefully if pre-built wheel is unavailable
RUN pip install --no-cache-dir \
    -f https://dl.fbaipublicfiles.com/detectron2/wheels/cpu/torch2.2/index.html \
    detectron2 || \
    pip install --no-cache-dir git+https://github.com/facebookresearch/detectron2.git@v0.6 || \
    echo "detectron2 unavailable; hi_res PDF will fall back to auto strategy"

COPY app ./app
COPY src ./src
COPY data ./data

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
